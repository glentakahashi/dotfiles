# Linux / WSL overrides (sourced early from zshrc). Works on a fresh
# Debian/Ubuntu box once deploy.sh has run, and degrades if it hasn't.

# en_US.UTF-8 often isn't generated on a fresh Debian/Ubuntu; C.UTF-8 always
# is. (A missing locale breaks the prompt's powerline glyphs.)
if locale -a 2>/dev/null | grep -qiE '^en_US\.utf-?8$'; then
  export LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8
else
  export LANG=C.UTF-8 LC_ALL=C.UTF-8
fi

# first, so deploy.sh's pinned fzf/delta and the fd/bat names (Debian calls them
# fdfind/batcat) win over older distro packages
path=(~/.local/bin ~/bin(N/) $path)

[[ -e ~/.dircolors ]] && eval "$(dircolors -b ~/.dircolors)"
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias egrep='grep -E --color=auto'

if [[ -n $WSL_DISTRO_NAME ]]; then
  # open files/dirs/URLs with the Windows default app
  open() {
    if (( $+commands[wslview] )); then wslview "$@"
    elif [[ $1 == *://* ]]; then explorer.exe "$1"
    else explorer.exe "$(wslpath -w "${1:-.}")"
    fi
  }
elif (( $+commands[xdg-open] )); then
  alias open='xdg-open'
fi
(( $+commands[gio] )) && alias trash='gio trash'
