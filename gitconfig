[user]
  name = Glen Takahashi
  email = glen@glentaka.com

[core]
  editor = vim
  # delta when installed, plain less otherwise (e.g. a fresh Linux box)
  pager = "if command -v delta >/dev/null 2>&1; then delta; else less -FRX; fi"

[interactive]
  # colorized hunks in `git add -p` (same fallback as core.pager)
  diffFilter = "if command -v delta >/dev/null 2>&1; then delta --color-only; else cat; fi"

[delta]
  navigate = true          # n / N jump between files in the pager
  line-numbers = true
  syntax-theme = Solarized (dark)
  hyperlinks = true        # file paths are clickable in iTerm

[color]
  diff = auto
  status = auto
  branch = auto
  ui = auto

[alias]
  # View abbreviated SHA, description, and history graph of the latest 20 commits
  l = log --pretty=oneline --decorate -n 20 --graph --abbrev-commit
  la = log --pretty=oneline --decorate -n 20 --graph --abbrev-commit --all

  # View the current working tree status using the short format
  s = status -s
  st = status

  # shortcuts
  ci = commit
  al = add . --all

  # find text
  find = !"git log --source --all -S "

  #clone one of my own repos
  cc = "!f() { git clone git@github.com:glentakahashi/$1; }; f"

  # Show the diff between the latest commit and the current state
  d = !"git diff-index --quiet HEAD --; git --no-pager diff --patch-with-stat"

  # `git di $number` shows the diff between the state `$number` revisions ago and the current state
  di = !"d() { git diff --patch-with-stat HEAD~$1; }; git diff-index --quiet HEAD --; d"

  # Show verbose output about tags, branches or remotes
  tags = tag -l
  branches = branch -a
  remotes = remote -v

  # Amend the currently staged files to the latest commit
  amend = commit --amend --reuse-message=HEAD

  # safer than `push --force` (you run that ~56x): refuses if the remote moved
  pf = push --force-with-lease
  unstage = reset HEAD --
  # make a fixup! commit for <sha>; squashed automatically by `rebase -i` (autoSquash)
  fixup = commit --fixup
  # branches by most recent commit
  recent = branch --sort=-committerdate --format='%(HEAD) %(color:yellow)%(refname:short)%(color:reset) %(color:blue)%(committerdate:relative)%(color:reset) %(contents:subject)'

[rebase]
  instructionFormat = (%an <%ae>) %s
  autoSquash = true
  autoStash = true
  # moves intermediate branch pointers when rebasing a stack of branches
  updateRefs = true

[push]
  autoSetupRemote = true
  followTags = true

[commit]
  # show the diff below the message in the commit editor
  verbose = true

[column]
  ui = auto

[tag]
  sort = version:refname

[fetch]
  prune = true

[rerere]
  # remember conflict resolutions; helps with repeated rebases onto master
  enabled = true
  autoupdate = true

[diff]
  algorithm = histogram
  colorMoved = default

[merge]
  # zdiff3 (git >= 2.35) is set in gitconfig.modern
  conflictStyle = diff3

[branch]
  sort = -committerdate

# Work repos: hex.tech identity + fsmonitor (git status in hex: ~200ms -> ~45ms).
# gitdir matches the main checkout and its worktrees.
[includeIf "gitdir:~/projects/hex/"]
  path = ~/projects/dotfiles/gitconfig.hex
