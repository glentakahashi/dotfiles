#Mac specific overrides

# path_helper (/etc/paths.d). It's POSIX sh, so source it in sh emulation.
emulate sh -c '. /etc/profile'

export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8

#java (skip if no JDK is installed; java_home prints an error otherwise)
JAVA_HOME=$(/usr/libexec/java_home 2>/dev/null) && export JAVA_HOME || unset JAVA_HOME

export PATH=/opt/homebrew/bin:/opt/homebrew/opt/coreutils/libexec/gnubin:/usr/local/bin:/usr/local/sbin:/usr/bin:~/bin:/usr/local/lib64:$PATH
export MANPATH="/opt/homebrew/opt/coreutils/libexec/gnuman:$MANPATH"

#mac needs overrides to use colors
# `auto`, not `always`: always leaks escape codes into pipes (`grep x | xargs ...`)
test -e ~/.dircolors && eval `dircolors -b ~/.dircolors`
alias ls="ls --color=auto"
alias grep="grep --color=auto"
alias egrep="grep -E --color=auto"

#fix for sed for mac
#we cannot export those because it screws over terminal encoding
alias sed="LC_ALL=C sed"

